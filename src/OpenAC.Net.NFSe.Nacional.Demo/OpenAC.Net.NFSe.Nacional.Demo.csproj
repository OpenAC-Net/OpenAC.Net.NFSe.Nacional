<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/openac.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="OpenAC.Net.NFSe.Nacional.Demo.Tests" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="NLog" Version="6.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenAC.Net.NFSe.Nacional/OpenAC.Net.NFSe.Nacional.csproj" />
    <ProjectReference Include="../OpenAC.Net.NFSe.Nacional.DANFSe.PDFSharp/OpenAC.Net.NFSe.Nacional.DANFSe.PDFSharp.csproj" />
  </ItemGroup>
</Project>
